# Generate real local values with python scripts/init_env.py. Never commit .env.
IR_INTAKE_TOKEN=GENERATE_ME
IR_WORKER_TOKEN=GENERATE_ME
IR_ADMIN_TOKEN=GENERATE_ME
IR_SIMULATOR_TOKEN=GENERATE_ME
N8N_ENCRYPTION_KEY=GENERATE_ME
IR_DATABASE=data/intake.db
IR_API_URL=http://127.0.0.1:8765
IR_SIMULATOR_URL=http://127.0.0.1:8765/simulator/send
IR_BASE_DELAY=5
IR_LEASE_SECONDS=30
N8N_PORT=5678
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
# HTTP node expressions read only IR_API_URL. Only trusted local operators may edit workflows.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_PERSONALIZATION_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
EXECUTIONS_DATA_SAVE_ON_ERROR=none
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
N8N_LOG_LEVEL=error

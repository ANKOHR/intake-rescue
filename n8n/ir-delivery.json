{
  "id": "ir-delivery",
  "name": "Intake Rescue \u00b7 03 Approved delivery and retries",
  "active": false,
  "nodes": [
    {
      "id": "every-5-seconds",
      "name": "Every 5 seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        420
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "run-delivery-now",
      "name": "Run delivery now",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        180
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "intake-rescue/deliver",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ir-worker-auth",
          "name": "Intake Rescue \u00b7 Worker"
        }
      },
      "webhookId": "ir-run-delivery-now"
    },
    {
      "id": "claim-one-approved-follow-up",
      "name": "Claim one approved follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.IR_API_URL + '/internal/outbox/claim' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ir-worker-auth",
          "name": "Intake Rescue \u00b7 Worker"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "each-exclusively-leased-job",
      "name": "Each exclusively leased job",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        300
      ],
      "parameters": {
        "fieldToSplitOut": "jobs",
        "options": {}
      }
    },
    {
      "id": "call-simulated-delivery-adapter",
      "name": "Call simulated delivery adapter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.IR_API_URL + '/internal/deliver' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ir-worker-auth",
          "name": "Intake Rescue \u00b7 Worker"
        }
      },
      "retryOnFail": false,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "delivery-confirmed?",
      "name": "Delivery confirmed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "sent",
              "leftValue": "={{ $json.state }}",
              "rightValue": "sent",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "simulated-receipt-recorded",
      "name": "Simulated receipt recorded",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1100,
        220
      ],
      "parameters": {}
    },
    {
      "id": "retry-or-dead-letter-stored",
      "name": "Retry or dead-letter stored",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1100,
        420
      ],
      "parameters": {}
    },
    {
      "id": "note-15020",
      "name": "Note 15020",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        150,
        20
      ],
      "parameters": {
        "content": "## Approval gate + leased outbox\nClaim succeeds only for a queued approved draft. One claim per tick. 30-second lease; HTTP timeout 5 seconds. Stable outbox ID is the provider idempotency key.",
        "width": 650,
        "height": 180
      }
    },
    {
      "id": "note-90020",
      "name": "Note 90020",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        900,
        20
      ],
      "parameters": {
        "content": "## Bounded retries\n429 / 5xx / transport failure \u2192 due_at + backoff.\n4 attempts maximum, then dead-letter.\nPermanent 4xx \u2192 manual attention. Never send directly from the dashboard.",
        "width": 560,
        "height": 180
      }
    }
  ],
  "connections": {
    "Every 5 seconds": {
      "main": [
        [
          {
            "node": "Claim one approved follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run delivery now": {
      "main": [
        [
          {
            "node": "Claim one approved follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim one approved follow-up": {
      "main": [
        [
          {
            "node": "Each exclusively leased job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Each exclusively leased job": {
      "main": [
        [
          {
            "node": "Call simulated delivery adapter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call simulated delivery adapter": {
      "main": [
        [
          {
            "node": "Delivery confirmed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delivery confirmed?": {
      "main": [
        [
          {
            "node": "Simulated receipt recorded",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Retry or dead-letter stored",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveExecutionProgress": false,
    "timezone": "Europe/London",
    "executionTimeout": 60,
    "errorWorkflow": "ir-errors"
  },
  "pinData": {},
  "tags": []
}
